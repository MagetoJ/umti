<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="umti_students.LibraryDashboardTemplate">
        <div class="o_dashboard_container p-4 bg-100 overflow-auto" style="height: 100vh;">
            <h2 class="mb-4 text-secondary font-weight-bold">Library &amp; Learning Resources Dashboard</h2>

            <!-- KPI Cards -->
            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <div class="card shadow-sm border-start border-secondary border-4 p-3 bg-white">
                        <div class="text-muted small fw-bold">CATALOG TITLES</div>
                        <div class="h3 mb-0 text-dark" t-esc="data.kpis.total_titles"/>
                        <div class="text-secondary small mt-1"><t t-esc="data.kpis.total_copies"/> Total Physical Copies</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card shadow-sm border-start border-success border-4 p-3 bg-white">
                        <div class="text-muted small fw-bold">AVAILABLE COPIES</div>
                        <div class="h3 mb-0 text-success" t-esc="data.kpis.available_copies"/>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card shadow-sm border-start border-warning border-4 p-3 bg-white">
                        <div class="text-muted small fw-bold">ACTIVE LOANS</div>
                        <div class="h3 mb-0 text-warning" t-esc="data.kpis.active_loans"/>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card shadow-sm border-start border-danger border-4 p-3 bg-white">
                        <div class="text-muted small fw-bold">OVERDUE BOOKS</div>
                        <div class="h3 mb-0 text-danger" t-esc="data.kpis.overdue_loans"/>
                    </div>
                </div>
            </div>

            <!-- Table & Charts -->
            <div class="row g-3">
                <div class="col-md-7">
                    <div class="card shadow-sm p-3 bg-white">
                        <h5 class="card-title text-muted fw-bold border-bottom pb-2">Top Overdue Borrowers</h5>
                        <table class="table table-sm table-hover mt-2">
                            <thead class="table-light">
                                <tr>
                                    <th>Student</th>
                                    <th>Book Title</th>
                                    <th>Due Date</th>
                                    <th>Fine (KSh)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="data.overdue_list" t-as="item" t-key="item_index">
                                    <tr>
                                        <td t-esc="item.student"/>
                                        <td t-esc="item.book"/>
                                        <td t-esc="item.due_date"/>
                                        <td class="text-danger fw-bold" t-esc="item.fine"/>
                                    </tr>
                                </t>
                                <t t-if="data.overdue_list.length == 0">
                                    <tr>
                                        <td colspan="4" class="text-center text-muted">No overdue loans currently.</td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="col-md-5">
                    <div class="card shadow-sm p-3 bg-white">
                        <h5 class="card-title text-muted fw-bold border-bottom pb-2">Inventory Availability Ratio</h5>
                        <div style="height: 260px;">
                            <canvas t-ref="copiesChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>