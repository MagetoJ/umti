<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_school_student" model="ir.sequence">
        <field name="name">Student Admission Number</field>
        <field name="code">school.student</field>
        <field name="prefix">ADM/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_school_admission_application" model="ir.sequence">
        <field name="name">Admission Application Number</field>
        <field name="code">school.admission.application</field>
        <field name="prefix">APP/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_school_fee_receipt" model="ir.sequence">
        <field name="name">Fee Receipt Number</field>
        <field name="code">school.fee.record</field>
        <field name="prefix">RCT/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
