    <!-- Managers see every service, including confidential cases. -->
    <record id="group_umti_students_manager" model="res.groups">
        <field name="implied_ids" eval="[
            (4, ref('group_umti_student_services_user')),
            (4, ref('group_umti_service_counselling')),
            (4, ref('group_umti_service_welfare')),
            (4, ref('group_umti_service_discipline')),
            (4, ref('group_umti_service_careers')),
            (4, ref('group_umti_service_accommodation')),
            (4, ref('group_umti_service_health')),
            (4, ref('group_umti_service_scholarships')),
            (4, ref('group_umti_service_clearance')),
            (4, ref('group_umti_service_activities')),
            (4, ref('group_umti_service_grievances')),
            (4, ref('group_umti_service_transport')),
            (4, ref('group_umti_service_onboarding')),
            (4, ref('group_umti_service_inclusion')),
            (4, ref('group_umti_service_alumni'))]"/>
    </record>

    <record id="umti_student_service_case_company_rule" model="ir.rule">
        <field name="name">Student service case: multi-company</field>
        <field name="model_id" ref="model_umti_student_service_case"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="umti_student_service_case_confidential_rule" model="ir.rule">
        <field name="name">Student service case: confidential services</field>
        <field name="model_id" ref="model_umti_student_service_case"/>
        <field name="groups" eval="[(4, ref('group_umti_student_services_user'))]"/>
        <field name="domain_force">['|', ('confidential', '=', False), ('service_type_id.group_ids', 'in', user.groups_id.ids)]</field>
    </record>
</odoo>
