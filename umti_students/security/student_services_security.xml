    <record id="group_umti_service_accommodation" model="res.groups">
        <field name="name">Accommodation</field>
        <field name="category_id" ref="module_category_umti_students"/>
        <field name="implied_ids" eval="[(4, ref('group_umti_student_services_user'))]"/>
    </record>
    <record id="group_umti_service_health" model="res.groups">
        <field name="name">Health &amp; Clinic</field>
        <field name="category_id" ref="module_category_umti_students"/>
        <field name="implied_ids" eval="[(4, ref('group_umti_student_services_user'))]"/>
    </record>
    <record id="group_umti_service_scholarships" model="res.groups">
        <field name="name">Scholarships &amp; Sponsorship</field>
