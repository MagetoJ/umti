        <field name="implied_ids" eval="[(4, ref('group_umti_student_services_user'))]"/>
    </record>
    <record id="group_umti_service_grievances" model="res.groups">
        <field name="name">Grievances &amp; Feedback</field>
        <field name="category_id" ref="module_category_umti_students"/>
