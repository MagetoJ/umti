<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_umti_student_services_user" model="res.groups">
        <field name="name">Student Services</field>
        <field name="category_id" ref="module_category_umti_students"/>
        <field name="implied_ids" eval="[(4, ref('group_umti_students_user'))]"/>
    </record>

    <record id="group_umti_service_counselling" model="res.groups">
        <field name="name">Guidance &amp; Counselling</field>
        <field name="category_id" ref="module_category_umti_students"/>
        <field name="implied_ids" eval="[(4, ref('group_umti_student_services_user'))]"/>
    </record>
