<odoo>
    <record id="umti_counselling_case_view_list" model="ir.ui.view">
        <field name="name">umti.counselling.case.list</field>
        <field name="model">umti.counselling.case</field>
        <field name="arch" type="xml">
            <list>
                <field name="student_id"/>
                <field name="name"/>
                <field name="category"/>
                <field name="risk_level"/>
                <field name="assigned_to"/>
                <field name="opened_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="counselling_view_form" model="ir.ui.view">
        <field name="name">umti.counselling.case.form</field>
        <field name="model">umti.counselling.case</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="student_id"/>
                        <field name="name"/>
                        <field name="category"/>
                        <field name="risk_level"/>
                        <field name="assigned_to"/>
                        <field name="opened_date"/>
                        <field name="closed_date"/>
                        <field name="resolution"/>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="counselling_view_search" model="ir.ui.view">
        <field name="name">umti.counselling.case.search</field>
        <field name="model">umti.counselling.case</field>
        <field name="arch" type="xml">
            <search>
                <field name="student_id"/>
                <field name="name"/>
                <field name="category"/>
                <field name="state"/>

                <group expand="0" string="Group By">
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_umti_counselling_records" model="ir.actions.act_window">
        <field name="name">Guidance &amp; Counselling</field>
        <field name="res_model">umti.counselling.case</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="umti_counselling_case_view_list"/>
        <field name="search_view_id" ref="counselling_view_search"/>
    </record>

    <record id="action_umti_counselling_dashboard" model="ir.actions.client">
        <field name="name">Guidance &amp; Counselling</field>
        <field name="tag">umti_section_dashboard</field>
