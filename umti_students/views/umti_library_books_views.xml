<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form View -->
        <record id="umti_library_books_form" model="ir.ui.view">
            <field name="name">umti.library.books.form</field>
            <field name="model">umti.library.books</field>
            <field name="arch" type="xml">
                <form string="Books">
                    <header>
                        <field name="status" widget="statusbar" statusbar_visible="available,unavailable,lost"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="view_all_lendings" type="object" string="Lendings" class="oe_stat_button" icon="fa-book">
                                <field name="lending_counts" widget="statinfo" string="Lendings"/>
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="title"/>
                                <field name="internal_reference"/>
                                <field name="genre_id"/>
                                <field name="author_id"/>
                                <field name="publisher_id"/>
                                <field name="isbn"/>
                                <field name="bar_code"/>
                            </group>
                            <group>
                                <field name="edition"/>
                                <field name="year"/>
                                <field name="pages"/>
                                <field name="description"/>
                                <field name="date_acquired"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="purchase_price"/>
                                <field name="daily_overdue_charge"/>
                            </group>                          
                            
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>
        
        <!-- List View -->
        <record id="umti_library_books_list" model="ir.ui.view">
            <field name="name">umti.library.books.list</field>
            <field name="model">umti.library.books</field>
            <field name="arch" type="xml">
                <list string="Books">
                    <field name="title"/>
                    <field name="internal_reference"/>
                    <field name="genre_id"/>
                    <field name="author_id"/>
                    <field name="publisher_id"/>
                    <field name="isbn"/>
                    <field name="status" widget="badge"
                        decoration-success="status == 'available'"
                        decoration-warning="status == 'unavailable'"
                        decoration-danger="status == 'lost'"
                    />
                </list>
            </field>
        </record>
        
        <!-- Kanban View -->
        <record id="umti_library_books_kanban" model="ir.ui.view">
            <field name="name">umti.library.books.kanban</field>
            <field name="model">umti.library.books</field>
            <field name="arch" type="xml">
                <kanban default_group_by="status">
                    <field name="status"/>
                    <templates>
                        <t t-name="card">
                            <main>
                                <field name="title" class="fw-bold fs-5"/>
                                <field name="internal_reference" class="text-muted"/>
                                <field name="author_id"/>
                                <field name="genre_id"/>
                                <field name="isbn"/>
                                <footer>
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'available'"
                                           decoration-warning="status == 'unavailable'"
                                           decoration-danger="status == 'lost'"/>
                                </footer>
                            </main>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Search View -->
        <record id="umti_library_books_search" model="ir.ui.view">
            <field name="name">umti.library.books.search</field>
            <field name="model">umti.library.books</field>
            <field name="arch" type="xml">
                <search>
                    <field name="title"/>
                    <field name="internal_reference"/>
                    <field name="isbn"/>
                    <field name="bar_code"/>
                    <field name="author_id"/>
                    <field name="genre_id"/>
                    <field name="publisher_id"/>
                    <filter name="filter_available" string="Available" domain="[('status', '=', 'available')]"/>
                    <filter name="filter_unavailable" string="Unavailable" domain="[('status', '=', 'unavailable')]"/>
                    <filter name="filter_lost" string="Lost" domain="[('status', '=', 'lost')]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                        <filter name="group_genre" string="Genre" context="{'group_by': 'genre_id'}"/>
                        <filter name="group_author" string="Author" context="{'group_by': 'author_id'}"/>
                        <filter name="group_publisher" string="Publisher" context="{'group_by': 'publisher_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_umti_library_books" model="ir.actions.act_window">
            <field name="name">Books</field>
            <field name="res_model">umti.library.books</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="search_view_id" ref="umti_library_books_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first book!
                </p>
            </field>
        </record>
        
        
    </data>
</odoo>