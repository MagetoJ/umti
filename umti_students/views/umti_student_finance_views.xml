<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Student invoice list/search -->
    <record id="umti_student_invoice_view_list" model="ir.ui.view">
        <field name="name">umti.student.invoice.list</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="name"/>
                <field name="invoice_date"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="umti_student_id"/>
                <field name="umti_course_id" optional="show"/>
                <field name="umti_academic_term_id" optional="show"/>
                <field name="umti_invoice_kind" optional="hide"/>
                <field name="amount_total" sum="Invoiced"/>
                <field name="amount_residual" sum="Outstanding"/>
                <field name="payment_state" widget="badge"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="umti_student_invoice_view_search" model="ir.ui.view">
        <field name="name">umti.student.invoice.search</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="umti_student_id"/>
                <field name="umti_course_id"/>
                <field name="umti_academic_term_id"/>
                <field name="umti_academic_year_id"/>
                <field name="umti_student_state"/>
                <field name="umti_invoice_kind"/>
                <filter name="filter_intake" string="Intake" domain="[('umti_invoice_kind','=','intake')]"/>
                <filter name="filter_semester" string="Semester" domain="[('umti_invoice_kind','=','semester')]"/>
                <separator/>
                <filter name="filter_unpaid" string="Unpaid" domain="[('payment_state','in',('not_paid','blocked'))]"/>
                <filter name="filter_partial" string="Partial" domain="[('payment_state','=','partial')]"/>
                <filter name="filter_paid" string="Paid" domain="[('payment_state','=','paid')]"/>
                <filter name="filter_draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="filter_posted" string="Posted" domain="[('state','=','posted')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_student" string="Student" context="{'group_by': 'umti_student_id'}"/>
                    <filter name="group_course" string="Course" context="{'group_by': 'umti_course_id'}"/>
                    <filter name="group_term" string="Semester" context="{'group_by': 'umti_academic_term_id'}"/>
                    <filter name="group_year" string="Academic Year" context="{'group_by': 'umti_academic_year_id'}"/>
                    <filter name="group_payment" string="Payment Status" context="{'group_by': 'payment_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_umti_student_invoices" model="ir.actions.act_window">
        <field name="name">Student Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="umti_student_invoice_view_list"/>
        <field name="search_view_id" ref="umti_student_invoice_view_search"/>
        <field name="domain">[('move_type', '=', 'out_invoice'), ('umti_student_id', '!=', False)]</field>
    </record>

    <!-- Student payment list/search -->
    <record id="umti_student_payment_view_list" model="ir.ui.view">
        <field name="name">umti.student.payment.list</field>
        <field name="model">account.payment</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="date"/>
                <field name="umti_student_id"/>
                <field name="umti_course_id" optional="show"/>
                <field name="partner_id" optional="hide"/>
                <field name="amount"/>
                <field name="currency_id" optional="hide"/>
                <field name="journal_id"/>
                <field name="payment_method_line_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="umti_student_payment_view_search" model="ir.ui.view">
        <field name="name">umti.student.payment.search</field>
        <field name="model">account.payment</field>
        <field name="arch" type="xml">
            <search>
                <field name="umti_student_id"/>
                <field name="partner_id"/>
                <field name="umti_course_id"/>
                <field name="umti_student_state"/>
                <field name="journal_id"/>
                <field name="date"/>
                <filter name="filter_posted" string="Posted" domain="[('state','=','posted')]"/>
                <filter name="filter_draft" string="Draft" domain="[('state','=','draft')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_student" string="Student" context="{'group_by': 'umti_student_id'}"/>
                    <filter name="group_course" string="Course" context="{'group_by': 'umti_course_id'}"/>
                    <filter name="group_journal" string="Journal" context="{'group_by': 'journal_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_umti_student_payments" model="ir.actions.act_window">
        <field name="name">Student Payments</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="umti_student_payment_view_list"/>
        <field name="search_view_id" ref="umti_student_payment_view_search"/>
        <field name="domain">[('umti_student_id', '!=', False)]</field>
    </record>

    <record id="action_umti_student_finance_dashboard" model="ir.actions.client">
        <field name="name">Dashboard</field>
        <field name="tag">umti_section_dashboard</field>
        <field name="context">{'umti_section': 'finance'}</field>
    </record>

    <!-- Menus: top-level Student Finance after Students -->
    <menuitem id="menu_school_finance"
              name="Student Finance"
              parent="menu_school_students"
              action="action_umti_student_finance_dashboard"
              sequence="20"
              groups="group_umti_student_finance"/>

</odoo>
