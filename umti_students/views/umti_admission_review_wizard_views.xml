<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_umti_admission_review_wizard_form" model="ir.ui.view">
        <field name="name">umti.admission.review.wizard.form</field>
        <field name="model">umti.admission.review.wizard</field>
        <field name="arch" type="xml">
            <form string="Review Application">
                <field name="application_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <div class="d-flex justify-content-between align-items-center">
                    <h2><field name="applicant_name"/></h2>
                    <field name="state" widget="badge"
                           decoration-info="state in ('submitted', 'review')"
                           decoration-success="state in ('accepted', 'enrolled')"
                           decoration-danger="state == 'rejected'"/>
                </div>
                <group>
                    <group string="Application">
                        <field name="application_no"/>
                        <field name="intake_id"/>
                        <field name="course_id"/>
                        <field name="academic_year_id"/>
                        <field name="semester_id"/>
                    </group>
                    <group string="Applicant">
                        <field name="gender"/>
                        <field name="date_of_birth"/>
                        <field name="nationality_id"/>
                        <field name="mobile"/>
                        <field name="email"/>
                    </group>
                </group>
                <group>
                    <group string="Guardian">
                        <field name="guardian_name"/>
                        <field name="guardian_relationship"/>
                        <field name="guardian_phone"/>
                    </group>
                    <group string="Admission Fee">
                        <field name="admission_fee"/>
                        <field name="fee_paid"/>
                        <field name="fee_reference"/>
                    </group>
                </group>
                <group string="Documents">
                    <field name="missing_documents" class="text-danger"
                           invisible="not missing_documents"/>
                    <field name="document_ids" nolabel="1" colspan="2">
                        <list create="0" delete="0">
                            <field name="name" string="Document"/>
                            <field name="filename" column_invisible="True"/>
                            <field name="attachment" filename="filename"/>
                            <field name="status" widget="badge"
                                   decoration-danger="status == 'missing'"
                                   decoration-info="status == 'uploaded'"
                                   decoration-success="status in ('verified', 'waived')"/>
                            <field name="waived"/>
                        </list>
                    </field>
                </group>
                <group string="Decision" invisible="state not in ('submitted', 'review')">
                    <field name="reviewer_notes" placeholder="Optional notes, saved in the application's chatter"/>
                    <field name="rejection_reason" placeholder="Required only when rejecting"/>
                </group>
                <footer>
                    <button name="action_start_review" type="object" string="Start Review"
                            class="btn-primary" invisible="state != 'submitted'"/>
                    <button name="action_accept" type="object" string="Accept"
                            class="btn-primary" invisible="state != 'review'"
                            confirm="Accept this applicant?"/>
                    <button name="action_enrol" type="object" string="Enrol Student"
                            class="btn-primary" invisible="state != 'accepted'"
                            confirm="Create the student record for this applicant?"/>
                    <button name="action_reject" type="object" string="Reject"
                            class="btn-danger" invisible="state not in ('submitted', 'review')"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
