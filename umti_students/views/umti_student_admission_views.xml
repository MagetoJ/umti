<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="school_student_view_form_admission" model="ir.ui.view">
        <field name="name">school.student.form.admission</field>
        <field name="model">school.student</field>
        <field name="inherit_id" ref="umti_students.school_student_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="application_id" invisible="not application_id"/>
            </xpath>
        </field>
    </record>
</odoo>
