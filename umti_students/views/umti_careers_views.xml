<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="umti_attachment_view_form" model="ir.ui.view">
        <field name="name">umti.student.attachment.form</field>
        <field name="model">umti.student.attachment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Start"
                            class="oe_highlight" invisible="state not in ('draft', 'pending')"/>
                    <button name="action_complete" type="object" string="Complete"
                            class="oe_highlight" invisible="state != 'active'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('completed', 'cancelled')"/>
                    <button name="action_reopen" type="object" string="Reopen"
                            invisible="state not in ('completed', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,pending,active,completed"/>
                </header>
                <sheet>
                    <group>
                        <group string="Student">
                            <field name="student_id"/>
                            <field name="course_id" readonly="1"/>
                            <field name="student_state" readonly="1"/>
                        </group>
                        <group string="Placement">
                            <field name="employer"/>
                            <field name="placement_type"/>
                            <field name="supervisor"/>
                            <field name="supervisor_phone"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="visit_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Logbook">
                            <field name="logbook_summary"/>
                        </page>
                        <page string="Assessment">
                            <field name="assessment"/>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                        <page string="Attachments">
                            <field name="attachment_ids" widget="many2many_binary"
                                   nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="umti_attachment_view_list" model="ir.ui.view">
        <field name="name">umti.student.attachment.list</field>
        <field name="model">umti.student.attachment</field>
        <field name="arch" type="xml">
            <list>
                <field name="student_id"/>
                <field name="employer"/>
                <field name="placement_type"/>
                <field name="supervisor"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="umti_attachment_view_search" model="ir.ui.view">
        <field name="name">umti.student.attachment.search</field>
        <field name="model">umti.student.attachment</field>
        <field name="arch" type="xml">
            <search>
                <field name="student_id"/>
                <field name="employer"/>
                <field name="course_id"/>
                <field name="state"/>
                <filter name="filter_active" string="Active"
                        domain="[('state','=','active')]"/>
                <filter name="filter_pending" string="Pending"
                        domain="[('state','=','pending')]"/>
                <filter name="filter_completed" string="Completed"
                        domain="[('state','=','completed')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="State"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_course" string="Course"
                            context="{'group_by': 'course_id'}"/>
                    <filter name="group_placement" string="Placement Type"
                            context="{'group_by': 'placement_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_umti_attachments" model="ir.actions.act_window">
        <field name="name">Attachments</field>
        <field name="res_model">umti.student.attachment</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="umti_attachment_view_list"/>
        <field name="search_view_id" ref="umti_attachment_view_search"/>
    </record>

    <record id="action_umti_careers_dashboard" model="ir.actions.client">
        <field name="name">Careers &amp; Attachment</field>
        <field name="tag">umti_section_dashboard</field>
        <field name="context">{'umti_section': 'careers'}</field>
    </record>

    <record id="umti_attachment_company_rule" model="ir.rule">
        <field name="name">Student attachment: multi-company</field>
        <field name="model_id" ref="model_umti_student_attachment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
