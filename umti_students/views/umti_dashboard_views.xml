<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Every area dashboard is the same client action (umti_core) pointed
         at a section through its context. -->
    <record id="action_umti_student_dashboard" model="ir.actions.client">
        <field name="name">Students Dashboard</field>
        <field name="tag">umti_section_dashboard</field>
        <field name="context">{'umti_section': 'students'}</field>
    </record>

    <record id="action_umti_kits_dashboard" model="ir.actions.client">
        <field name="name">Kits &amp; Equipment Dashboard</field>
        <field name="tag">umti_section_dashboard</field>
        <field name="context">{'umti_section': 'kits'}</field>
    </record>

    <record id="action_umti_library_dashboard" model="ir.actions.client">
        <field name="name">Library Dashboard</field>
        <field name="tag">umti_section_dashboard</field>
        <field name="context">{'umti_section': 'library'}</field>
    </record>

    <record id="action_umti_faculty_dashboard" model="ir.actions.client">
        <field name="name">Faculty Dashboard</field>
        <field name="tag">umti_faculty_dashboard_action</field>
    </record>

    <!-- Each dashboard is the first entry of its own app, so the main
         "Dashboard" menu stays a plain link without a dropdown. -->
    <menuitem id="menu_school_dashboard"
              name="Dashboard"
              parent="menu_school_root"
              action="action_umti_student_dashboard"
              sequence="1"/>

    <menuitem id="menu_library_dashboard"
              name="Dashboard"
              parent="menu_school_library"
              action="action_umti_library_dashboard"
              sequence="1"/>

    <menuitem id="menu_kits_dashboard"
              name="Dashboard"
              parent="menu_school_kits_parent"
              action="action_umti_kits_dashboard"
              sequence="1"/>
</odoo>
