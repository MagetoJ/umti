<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================= -->
        <!--  TRAINER RECORD RULES                         -->
        <!-- ============================================= -->

        <!-- Trainers see only their own allocations -->
        <record id="rule_trainer_allocation_trainer" model="ir.rule">
            <field name="name">Trainers: own records only</field>
            <field name="model_id" ref="model_umti_trainer_allocation"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_umti_trainers_user'))]"/>
        </record>

        <!-- Trainers see only their own schemes of work -->
        <record id="rule_scheme_of_work_trainer" model="ir.rule">
            <field name="name">Scheme of Work: own records only</field>
            <field name="model_id" ref="model_umti_scheme_of_work"/>
            <field name="domain_force">[('trainer_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_umti_trainers_user'))]"/>
        </record>

        <!-- Trainers see only their own work plans -->
        <record id="rule_work_plan_trainer" model="ir.rule">
            <field name="name">Work Plan: own records only</field>
            <field name="model_id" ref="model_umti_work_plan"/>
            <field name="domain_force">[('trainer_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_umti_trainers_user'))]"/>
        </record>

        <!-- Trainers see only their own attendance sheets -->
        <record id="rule_attendance_sheet_trainer" model="ir.rule">
            <field name="name">Attendance Sheet: own records only</field>
            <field name="model_id" ref="model_umti_attendance_sheet"/>
            <field name="domain_force">[('trainer_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_umti_trainers_user'))]"/>
        </record>

        <!-- Trainers see only students assigned to them (read-only enforced via ACL) -->
        <record id="rule_student_trainer" model="ir.rule">
            <field name="name">Student: trainers see enrolled students only</field>
            <field name="model_id" ref="umti_students.model_school_student"/>
            <field name="domain_force">[('current_trainer_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('group_umti_trainers_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Trainers see only the enrollments where they are the trainer -->
        <record id="rule_enrollment_trainer" model="ir.rule">
            <field name="name">Enrollment: trainers see own students only</field>
            <field name="model_id" ref="model_umti_student_unit_enrollment"/>
            <field name="domain_force">[('trainer_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_umti_trainers_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- ============================================= -->
        <!--  HOD RECORD RULES (department scope)          -->
        <!-- ============================================= -->

        <record id="rule_trainer_allocation_hod" model="ir.rule">
            <field name="name">Trainers: HoD department</field>
            <field name="model_id" ref="model_umti_trainer_allocation"/>
            <field name="domain_force">[('department_id.manager_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_umti_trainers_manager'))]"/>
        </record>

        <record id="rule_scheme_of_work_hod" model="ir.rule">
            <field name="name">Scheme of Work: HoD department</field>
            <field name="model_id" ref="model_umti_scheme_of_work"/>
            <field name="domain_force">[('department_id.manager_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_umti_trainers_manager'))]"/>
        </record>

        <record id="rule_work_plan_hod" model="ir.rule">
            <field name="name">Work Plan: HoD department</field>
            <field name="model_id" ref="model_umti_work_plan"/>
            <field name="domain_force">[('department_id.manager_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_umti_trainers_manager'))]"/>
        </record>

        <record id="rule_attendance_sheet_hod" model="ir.rule">
            <field name="name">Attendance Sheet: HoD department</field>
            <field name="model_id" ref="model_umti_attendance_sheet"/>
            <field name="domain_force">[('department_id.manager_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_umti_trainers_manager'))]"/>
        </record>

        <record id="rule_student_hod" model="ir.rule">
            <field name="name">Student: HoD department</field>
            <field name="model_id" ref="umti_students.model_school_student"/>
            <field name="domain_force">[('department_id.manager_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_umti_trainers_manager'))]"/>
        </record>

        <!-- ============================================= -->
        <!--  MANAGER / ADMIN BYPASS RULES                 -->
        <!-- ============================================= -->

        <!-- Trainers Manager sees all records (overrides trainer/HoD restrictions) -->
        <record id="rule_student_manager_bypass" model="ir.rule">
            <field name="name">Student: trainers manager full access</field>
            <field name="model_id" ref="umti_students.model_school_student"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_umti_trainers_admin'))]"/>
        </record>

        <record id="rule_enrollment_manager_bypass" model="ir.rule">
            <field name="name">Enrollment: trainers manager full access</field>
            <field name="model_id" ref="model_umti_student_unit_enrollment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_umti_trainers_admin'))]"/>
        </record>

        <record id="rule_trainer_allocation_manager_bypass" model="ir.rule">
            <field name="name">Trainers: trainers manager full access</field>
            <field name="model_id" ref="model_umti_trainer_allocation"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_umti_trainers_admin'))]"/>
        </record>

        <record id="rule_scheme_of_work_manager_bypass" model="ir.rule">
            <field name="name">Scheme of Work: trainers manager full access</field>
            <field name="model_id" ref="model_umti_scheme_of_work"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_umti_trainers_admin'))]"/>
        </record>

        <record id="rule_work_plan_manager_bypass" model="ir.rule">
            <field name="name">Work Plan: trainers manager full access</field>
            <field name="model_id" ref="model_umti_work_plan"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_umti_trainers_admin'))]"/>
        </record>

        <record id="rule_attendance_sheet_manager_bypass" model="ir.rule">
            <field name="name">Attendance Sheet: trainers manager full access</field>
            <field name="model_id" ref="model_umti_attendance_sheet"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_umti_trainers_admin'))]"/>
        </record>

        <!-- System admin bypass for cross-module student model -->
        <record id="rule_student_system_bypass" model="ir.rule">
            <field name="name">Student: system admin full access</field>
            <field name="model_id" ref="umti_students.model_school_student"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>

        <!-- ============================================= -->
        <!--  MULTI-COMPANY RULES                          -->
        <!-- ============================================= -->

        <record id="rule_trainer_allocation_company" model="ir.rule">
            <field name="name">Trainers: multi-company</field>
            <field name="model_id" ref="model_umti_trainer_allocation"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_enrollment_company" model="ir.rule">
            <field name="name">Student Unit Enrollment: multi-company</field>
            <field name="model_id" ref="model_umti_student_unit_enrollment"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_unit_trainer_company" model="ir.rule">
            <field name="name">Unit Trainer: multi-company</field>
            <field name="model_id" ref="model_umti_unit_trainer"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_scheme_of_work_company" model="ir.rule">
            <field name="name">Scheme of Work: multi-company</field>
            <field name="model_id" ref="model_umti_scheme_of_work"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_work_plan_company" model="ir.rule">
            <field name="name">Work Plan: multi-company</field>
            <field name="model_id" ref="model_umti_work_plan"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_attendance_sheet_company" model="ir.rule">
            <field name="name">Attendance Sheet: multi-company</field>
            <field name="model_id" ref="model_umti_attendance_sheet"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <!-- ============================================= -->
        <!--  ATTENDANCE LINES & SUMMARY                   -->
        <!-- ============================================= -->
        <record id="rule_attendance_line_trainer" model="ir.rule">
            <field name="name">Attendance Line: own sheets only</field>
            <field name="model_id" ref="model_umti_attendance_line"/>
            <field name="domain_force">[('sheet_id.trainer_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_umti_trainers_user'))]"/>
        </record>

        <record id="rule_attendance_line_hod" model="ir.rule">
            <field name="name">Attendance Line: HoD department</field>
            <field name="model_id" ref="model_umti_attendance_line"/>
            <field name="domain_force">[('sheet_id.department_id.manager_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_umti_trainers_manager'))]"/>
        </record>

        <record id="rule_attendance_line_manager_bypass" model="ir.rule">
            <field name="name">Attendance Line: trainers manager full access</field>
            <field name="model_id" ref="model_umti_attendance_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_umti_trainers_admin'))]"/>
        </record>

        <record id="rule_attendance_line_company" model="ir.rule">
            <field name="name">Attendance Line: multi-company</field>
            <field name="model_id" ref="model_umti_attendance_line"/>
            <field name="domain_force">[('sheet_id.company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_attendance_summary_trainer" model="ir.rule">
            <field name="name">Attendance Summary: trainer's students</field>
            <field name="model_id" ref="model_umti_attendance_summary"/>
            <field name="domain_force">[('student_id.current_trainer_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('group_umti_trainers_user'))]"/>
        </record>

        <record id="rule_attendance_summary_hod" model="ir.rule">
            <field name="name">Attendance Summary: HoD department</field>
            <field name="model_id" ref="model_umti_attendance_summary"/>
            <field name="domain_force">[('department_id.manager_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_umti_trainers_manager'))]"/>
        </record>

        <record id="rule_attendance_summary_manager_bypass" model="ir.rule">
            <field name="name">Attendance Summary: trainers manager full access</field>
            <field name="model_id" ref="model_umti_attendance_summary"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_umti_trainers_admin'))]"/>
        </record>

        <record id="rule_attendance_summary_company" model="ir.rule">
            <field name="name">Attendance Summary: multi-company</field>
            <field name="model_id" ref="model_umti_attendance_summary"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
