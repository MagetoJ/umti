<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Trainer group: own records only (record rules scope the rows). -->
        <record id="group_umti_trainers_user" model="res.groups">
            <field name="name">Trainer</field>
            <field name="category_id" ref="module_category_umti_trainers"/>
            <field name="implied_ids" eval="[
                (4, ref('base.group_user')),
                (4, ref('umti_core.group_umti_user')),
                (4, ref('umti_core.group_umti_department_user')),
                (4, ref('umti_core.group_umti_academic_year_user'))]"/>
        </record>

        <!-- Manager group: the Head of Department. Record rules scope it to
             the rows of the departments they manage. -->
        <record id="group_umti_trainers_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_umti_trainers"/>
            <field name="implied_ids" eval="[(4, ref('group_umti_trainers_user'))]"/>
        </record>

        <record id="group_umti_trainers_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_umti_trainers"/>
            <field name="implied_ids" eval="[(4, ref('group_umti_trainers_manager'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

    </data>
</odoo>
