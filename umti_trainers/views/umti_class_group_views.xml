<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="umti_class_group_view_list" model="ir.ui.view">
        <field name="name">umti.class.group.list</field>
        <field name="model">umti.class.group</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="unit_id"/>
                <field name="department_id" optional="show"/>
                <field name="course_ids" widget="many2many_tags"/>
                <field name="enrollment_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="umti_class_group_view_form" model="ir.ui.view">
        <field name="name">umti.class.group.form</field>
        <field name="model">umti.class.group</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_enrollments" type="object"
                                class="oe_stat_button" icon="fa-users">
                            <field name="enrollment_count" widget="statinfo"
                                   string="Enrollments"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"
                                   placeholder="e.g. Hairdressing shared theory group"/></h1>
                    </div>
                    <group>
                        <group string="Teaching">
                            <field name="unit_id"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="department_id"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                        <group string="Cohorts">
                            <field name="course_ids" widget="many2many_tags"
                                   readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Cohort Terms" name="terms">
                            <field name="term_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="course_id"/>
                                    <field name="intake_id"/>
                                    <field name="term_start_date"/>
                                    <field name="term_end_date"/>
                                    <field name="status" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="umti_class_group_view_search" model="ir.ui.view">
        <field name="name">umti.class.group.search</field>
        <field name="model">umti.class.group</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="unit_id"/>
                <field name="course_ids"/>
                <filter name="filter_active" string="Active"
                        domain="[('active', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_unit" string="Unit"
                            context="{'group_by': 'unit_id'}"/>
                    <filter name="group_department" string="Department"
                            context="{'group_by': 'department_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_umti_class_group" model="ir.actions.act_window">
        <field name="name">Class Groups</field>
        <field name="res_model">umti.class.group</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="umti_class_group_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a shared teaching group for units taught across courses.
            </p>
        </field>
    </record>
</odoo>
