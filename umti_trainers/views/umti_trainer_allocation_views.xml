<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="umti_trainer_allocation_view_list" model="ir.ui.view">
        <field name="name">umti.trainer.allocation.list</field>
        <field name="model">umti.trainer.allocation</field>
        <field name="arch" type="xml">
            <list>
                <field name="trainer_name"/>
                <field name="employee_id" optional="hide"/>
                <field name="job_id" optional="hide"/>
                <field name="department_id"/>
                <field name="course_ids" widget="many2many_tags"/>
                <field name="unit_ids" widget="many2many_tags"/>
                <field name="contract_end_date" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-muted="state == 'draft'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'retired'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="umti_trainer_allocation_view_form" model="ir.ui.view">
        <field name="name">umti.trainer.allocation.form</field>
        <field name="model">umti.trainer.allocation</field>
        <field name="arch" type="xml">
            <form string="Trainers">
                <header>
                    <button name="action_approve" type="object"
                            string="Approve" class="btn-primary"
                            groups="umti_trainers.group_umti_trainers_manager"
                            invisible="state != 'draft'"/>
                    <button name="action_retire" type="object"
                            string="Retire" class="btn-danger"
                            groups="umti_trainers.group_umti_trainers_manager"
                            invisible="state != 'approved'"
                            confirm="Retire this trainer? All open contracts will be closed and the employee archived."/>
                    <button name="action_set_draft" type="object"
                            string="Set to Draft"
                            groups="umti_trainers.group_umti_trainers_manager"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,approved,retired"/>
                </header>
                <sheet>
                    <group>
                        <group string="Trainer Details">
                            <field name="trainer_name"/>
                            <field name="trainer_email" widget="email"/>
                            <field name="trainer_phone" widget="phone"/>
                            <field name="department_id"/>
                            <field name="job_id" options="{'no_create': True}"/>
                            <field name="employee_id" invisible="not employee_id"/>
                            <field name="active" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Contract">
                            <field name="contract_id"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="contract_start_date"/>
                            <field name="contract_end_date"/>
                            <field name="wage"/>
                        </group>
                        <group string="Course &amp; Unit Assignment">
                            <field name="course_ids" widget="many2many_tags"
                                   domain="[('department_id', '=', department_id)]"
                                   options="{'no_create': True}"/>
                            <field name="allowed_unit_ids" invisible="1"/>
                            <field name="unit_ids" widget="many2many_tags"
                                   domain="[('id', 'in', allowed_unit_ids)]"
                                   options="{'no_create': True, 'no_open': True}"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="umti_trainer_allocation_view_search" model="ir.ui.view">
        <field name="name">umti.trainer.allocation.search</field>
        <field name="model">umti.trainer.allocation</field>
        <field name="arch" type="xml">
            <search>
                <field name="trainer_name"
                       filter_domain="['|', ('trainer_name', 'ilike', self), ('trainer_email', 'ilike', self)]"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="job_id"/>
                <filter name="filter_draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="filter_approved" string="Approved"
                        domain="[('state', '=', 'approved')]"/>
                <filter name="filter_retired" string="Retired"
                        domain="[('state', '=', 'retired')]"/>
                <separator/>
                <filter name="filter_archived" string="Archived"
                        domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_trainer" string="Trainer" context="{'group_by': 'trainer_name'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
                    <filter name="group_job" string="Job Position" context="{'group_by': 'job_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="umti_trainer_allocation_view_kanban" model="ir.ui.view">
        <field name="name">umti.trainer.allocation.kanban</field>
        <field name="model">umti.trainer.allocation</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column"
                    quick_create="false" records_draggable="false" group_create="false">
                <field name="trainer_name"/>
                <field name="department_id"/>
                <field name="employee_id"/>
                <field name="trainer_email"/>
                <field name="trainer_phone"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click p-2">
                            <div class="o_kanban_record_top mb-1">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title fs-6">
                                        <field name="trainer_name"/>
                                    </strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_body text-muted small mb-2">
                                <div><i class="fa fa-building me-1"/> <field name="department_id"/></div>
                                <div t-if="record.trainer_email.raw_value"><i class="fa fa-envelope me-1"/> <field name="trainer_email"/></div>
                                <div t-if="record.trainer_phone.raw_value"><i class="fa fa-phone me-1"/> <field name="trainer_phone"/></div>
                                <div class="mt-1"><field name="course_ids" widget="many2many_tags"/></div>
                                <div><field name="unit_ids" widget="many2many_tags"/></div>
                            </div>
                            <div class="o_kanban_record_bottom border-top pt-2 mt-1 d-flex justify-content-between align-items-center">
                                <div class="oe_kanban_bottom_left">
                                    <field name="state" widget="badge"
                                           decoration-info="state == 'draft'"
                                           decoration-success="state == 'approved'"
                                           decoration-muted="state == 'retired'"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="employee_id" widget="many2one_avatar_employee"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action -->
    <record id="umti_trainer_allocation_action" model="ir.actions.act_window">
        <field name="name">Trainers</field>
        <field name="res_model">umti.trainer.allocation</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="umti_trainer_allocation_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first Trainers</p>
            <p>Capture the trainer particulars, then approve to create the employee, its portal user and an HR contract.</p>
        </field>
    </record>

</odoo>