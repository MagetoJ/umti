<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Scheme of Work Form View -->
    <record id="umti_scheme_of_work_view_form" model="ir.ui.view">
        <field name="name">umti.scheme.of.work.form</field>
        <field name="model">umti.scheme.of.work</field>
        <field name="arch" type="xml">
            <form string="Scheme of Work">
                <header>
                    <button name="action_submit" string="Submit for Approval" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve Scheme" type="object" class="oe_highlight" groups="umti_trainers.group_umti_work_plan_manager" invisible="state != 'submitted'"/>
                    <button name="action_reject" string="Request Revisions" type="object" groups="umti_trainers.group_umti_work_plan_manager" invisible="state != 'submitted'"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" invisible="state not in ('rejected', 'approved')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="title" placeholder="e.g. Diploma in Electrical Engineering - Circuit Theory Scheme"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Academic Context">
                            <field name="work_plan_id"/>
                            <field name="academic_term_id"/>
                            <field name="department_id"/>
                            <field name="unit_id"/>
                        </group>
                        <group string="Ownership &amp; Security">
                            <field name="trainer_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Weekly Syllabus &amp; Session Plans" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="week_number"/>
                                    <field name="session_no"/>
                                    <field name="session_title"/>
                                    <field name="learning_outcome"/>
                                    <field name="trainer_activities"/>
                                    <field name="resources_refs"/>
                                    <field name="planned_assessment_type" widget="badge"/>
                                    <field name="other_assessment_name" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Scheme of Work List View -->
    <record id="umti_scheme_of_work_view_list" model="ir.ui.view">
        <field name="name">umti.scheme.of.work.list</field>
        <field name="model">umti.scheme.of.work</field>
        <field name="arch" type="xml">
            <list string="Schemes of Work">
                <field name="title"/>
                <field name="trainer_id"/>
                <field name="department_id"/>
                <field name="unit_id"/>
                <field name="academic_term_id"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'submitted'" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_umti_scheme_of_work" model="ir.actions.act_window">
        <field name="name">Schemes of Work</field>
        <field name="res_model">umti.scheme.of.work</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Schemes of Work created yet. Generate them from an Approved Work Plan!
            </p>
        </field>
    </record>

</odoo>
