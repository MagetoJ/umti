<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Kanban View -->
    <record id="umti_work_plan_view_kanban" model="ir.ui.view">
        <field name="name">umti.work.plan.kanban</field>
        <field name="model">umti.work.plan</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" quick_create="false">
                <field name="name"/>
                <field name="department_id"/>
                <field name="course_unit_id"/>
                <field name="academic_term_id"/>
                <field name="is_master_plan"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click p-2">
                            <div class="o_kanban_record_top mb-1">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title fs-6">
                                        <field name="name"/>
                                    </strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_body text-muted small mb-2">
                                <div t-if="record.course_unit_id.raw_value"><i class="fa fa-book me-1"/> <field name="course_unit_id"/></div>
                                <div t-if="record.department_id.raw_value"><i class="fa fa-building me-1"/> <field name="department_id"/></div>
                                <div><i class="fa fa-calendar me-1"/> <field name="academic_term_id"/></div>
                            </div>
                            <div class="o_kanban_record_bottom border-top pt-2 mt-1 d-flex justify-content-between align-items-center">
                                <div class="oe_kanban_bottom_left">
                                    <field name="state" widget="label_selection"
                                           options="{'classes': {'draft': 'default', 'approved': 'warning', 'active': 'success', 'done': 'info'}}"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <span t-if="record.is_master_plan.raw_value" class="badge bg-primary">Master Plan</span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- List View -->
    <record id="umti_work_plan_view_list" model="ir.ui.view">
        <field name="name">umti.work.plan.list</field>
        <field name="model">umti.work.plan</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'draft'"
                  decoration-warning="state == 'approved'"
                  decoration-success="state in ('active', 'done')">
                <field name="name"/>
                <field name="academic_term_id"/>
                <field name="department_id"/>
                <field name="course_unit_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="total_weeks"/>
                <field name="is_master_plan"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'approved'"
                       decoration-success="state in ('active', 'done')"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="umti_work_plan_view_form" model="ir.ui.view">
        <field name="name">umti.work.plan.form</field>
        <field name="model">umti.work.plan</field>
        <field name="arch" type="xml">
            <form string="Master Institutional Work Plan">
                <header>
                    <button name="action_approve" string="Approve &amp; Lock Master Plan" type="object" 
                            class="oe_highlight" invisible="state != 'draft'"
                            groups="umti_trainers.group_umti_work_plan_manager"/>
                    
                    <button name="action_generate_schemes_of_work" string="Generate Schemes of Work" type="object" 
                            class="oe_highlight" invisible="state != 'approved'"
                            groups="umti_trainers.group_umti_work_plan_manager"/>

                    <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                            invisible="state == 'draft'"
                            groups="umti_trainers.group_umti_work_plan_manager"/>
                            
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,active,done"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Master Plan" bg_color="text-bg-primary" invisible="not is_master_plan"/>
                    <div class="oe_title">
                        <label for="name" string="Work Plan Title"/>
                        <h1>
                            <field name="name" placeholder="e.g. Master Academic Calendar &amp; Work Plan - Term 1 2026"
                                   readonly="state != 'draft'"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Institutional Scope">
                            <field name="is_master_plan" readonly="state != 'draft'"/>
                            <field name="academic_term_id" readonly="state != 'draft'"/>
                            <field name="department_id" readonly="state != 'draft'"/>
                            <field name="course_unit_id" invisible="is_master_plan" readonly="state != 'draft'"/>
                        </group>
                        <group string="Schedule Windows">
                            <field name="start_date" readonly="state != 'draft'"/>
                            <field name="end_date" readonly="state != 'draft'"/>
                            <field name="total_weeks" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <!-- Main Work Plan Lines Grid -->
                        <page string="Master Activity &amp; Curriculum Grid">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="week_number"/>
                                    <field name="slot_category" widget="badge"
                                           decoration-info="slot_category == 'learning'"
                                           decoration-warning="slot_category in ('assessment', 'cat')"
                                           decoration-danger="slot_category == 'exam'"
                                           decoration-success="slot_category in ('school_event', 'co_curricular')"/>
                                    <field name="name" string="Activity / Module Name"/>
                                    <field name="topic"/>
                                    <field name="subtopics_outline" optional="show"/>
                                    <field name="learning_activities" optional="hide"/>
                                    <field name="planned_assessment_type" widget="badge"/>
                                    <field name="other_assessment_name" 
                                           placeholder="Custom Title (e.g. Viva, Field Report)"
                                           invisible="planned_assessment_type != 'other'"
                                           required="planned_assessment_type == 'other'"/>
                                    <field name="resources" optional="hide"/>
                                </list>
                            </field>
                        </page>

                        <!-- Readonly Tab: Co-Curricular & School Events -->
                        <page string="School &amp; Co-Curricular Events">
                            <field name="line_ids" readonly="1" domain="[('slot_category', 'in', ('school_event', 'co_curricular', 'holiday'))]">
                                <list>
                                    <field name="week_number"/>
                                    <field name="slot_category" widget="badge"/>
                                    <field name="name"/>
                                    <field name="resources" string="Required Facilities"/>
                                </list>
                            </field>
                        </page>

                        <!-- Readonly Tab: Exam & Assessment Windows -->
                        <page string="Exam &amp; Assessment Schedule">
                            <field name="line_ids" readonly="1" domain="[('slot_category', 'in', ('assessment', 'cat', 'exam'))]">
                                <list>
                                    <field name="week_number"/>
                                    <field name="planned_assessment_type" widget="badge"/>
                                    <field name="other_assessment_name" invisible="planned_assessment_type != 'other'"/>
                                    <field name="name"/>
                                    <field name="topic"/>
                                </list>
                            </field>
                        </page>

                        <!-- Generated Schemes of Work -->
                    <page string="Generated Schemes of Work" invisible="state == 'draft'">
                        <field name="scheme_ids" readonly="1">
        <list>
            <field name="title"/>
            <field name="trainer_id"/>
            <field name="department_id"/>
            <field name="unit_id"/>
            <field name="state" widget="badge"/>
        </list>
    </field>
                    </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="umti_work_plan_view_search" model="ir.ui.view">
        <field name="name">umti.work.plan.search</field>
        <field name="model">umti.work.plan</field>
        <field name="arch" type="xml">
            <search string="Search Master Work Plans">
                <field name="name"/>
                <field name="department_id"/>
                <field name="course_unit_id"/>
                <field name="academic_term_id"/>
                <filter string="Master Plans" name="filter_master" domain="[('is_master_plan', '=', True)]"/>
                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Approved" name="filter_approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Active" name="filter_active" domain="[('state', '=', 'active')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Department" name="groupby_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Academic Term" name="groupby_term" context="{'group_by': 'academic_term_id'}"/>
                    <filter string="State" name="groupby_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="umti_work_plan_action" model="ir.actions.act_window">
        <field name="name">Master Institutional Work Plans</field>
        <field name="res_model">umti.work.plan</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="umti_work_plan_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first Master Institutional Work Plan</p>
        </field>
    </record>

</odoo>