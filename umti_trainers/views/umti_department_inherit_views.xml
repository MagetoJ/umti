<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="umti_department_view_form_inherit_trainers" model="ir.ui.view">
        <field name="name">umti.department.form.inherit.trainers</field>
        <field name="model">umti.department</field>
        <field name="inherit_id" ref="umti_core.umti_department_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='code']" position="after">
                <field name="manager_id" options="{'no_create': True}"/>
            </xpath>

            <!-- Add stat buttons into existing button_box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_students" type="object"
                        class="oe_stat_button" icon="fa-users">
                    <field name="student_count" string="Students" widget="statinfo"/>
                </button>
                <button name="action_view_courses" type="object"
                        class="oe_stat_button" icon="fa-graduation-cap">
                    <field name="course_count" string="Courses" widget="statinfo"/>
                </button>
                <button name="action_view_trainers" type="object"
                        class="oe_stat_button" icon="fa-chalkboard-teacher">
                    <field name="trainer_count" string="Trainers" widget="statinfo"/>
                </button>
                <button name="action_view_exam_marks" type="object"
                        class="oe_stat_button" icon="fa-percent">
                    <div class="o_stat_info">
                        <span class="o_stat_value"><field name="exam_pass_rate" widget="float" digits="[5,1]"/>%</span>
                        <span class="o_stat_text">Pass Rate</span>
                    </div>
                </button>
                <button name="action_view_exam_marks" type="object"
                        class="oe_stat_button" icon="fa-bar-chart">
                    <div class="o_stat_info">
                        <span class="o_stat_value"><field name="avg_exam_mark" widget="float" digits="[5,1]"/>%</span>
                        <span class="o_stat_text">Avg Mark</span>
                    </div>
                </button>
            </xpath>

            <!-- Add Trainers & Exam Performance tabs into notebook -->
            <xpath expr="//notebook" position="inside">
                <page string="Trainers &amp; Allocations" name="trainers">
                    <field name="trainer_allocation_ids" readonly="1">
                        <list>
                            <field name="trainer_name" string="Trainer"/>
                            <field name="course_ids" widget="many2many_tags"/>
                            <field name="unit_ids" widget="many2many_tags"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </page>
                <page string="Exam Performance &amp; Analytics" name="exam_performance">
                    <group>
                        <group>
                            <field name="exam_pass_rate" string="Overall Pass Rate (%)"/>
                        </group>
                        <group>
                            <field name="avg_exam_mark" string="Average Mark (%)"/>
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

</odoo>