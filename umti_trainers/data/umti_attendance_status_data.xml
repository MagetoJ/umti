<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="attendance_status_absent" model="umti.attendance.status">
            <field name="name">Absent</field>
            <field name="code">absent</field>
            <field name="sequence">20</field>
            <field name="is_present" eval="False"/>
            <field name="is_default" eval="True"/>
        </record>
        <record id="attendance_status_present" model="umti.attendance.status">
            <field name="name">Present</field>
            <field name="code">present</field>
            <field name="sequence">10</field>
            <field name="is_present" eval="True"/>
        </record>
        <record id="attendance_status_excused" model="umti.attendance.status">
            <field name="name">Absent with Reason</field>
            <field name="code">excused</field>
            <field name="sequence">30</field>
            <field name="is_present" eval="False"/>
            <field name="counts_in_rate" eval="False"/>
        </record>
        <record id="attendance_status_late" model="umti.attendance.status">
            <field name="name">Late</field>
            <field name="code">late</field>
            <field name="sequence">15</field>
            <field name="is_present" eval="True"/>
        </record>
        <!-- Minimum attendance (%) before a student is flagged. Editable under
             Settings > Technical > System Parameters. -->
        <record id="config_attendance_threshold" model="ir.config_parameter">
            <field name="key">umti_trainers.attendance_threshold</field>
            <field name="value">75</field>
        </record>
    </data>
</odoo>
