<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form View -->
        <record id="umti_course_level_form" model="ir.ui.view">
            <field name="name">umti.course.level.form</field>
            <field name="model">umti.course.level</field>
            <field name="arch" type="xml">
                <form string="Course Levels">
                    <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_courses" type="object" class="oe_stat_button" icon="fa-book">
                            <field name="courses_counts" widget="statinfo"  string="Courses"/>
                        </button>
                    </div>
                        <group>
                            <field name="name"/>
                        </group>
                    </sheet>
                     <chatter/>
                </form>
            </field>
        </record>
        
        <!-- List View -->
        <record id="umti_course_level_list" model="ir.ui.view">
            <field name="name">umti.course.level.list</field>
            <field name="model">umti.course.level</field>
            <field name="arch" type="xml">
                <list string="Course Levels">
                    <field name="name"/>
                </list>
            </field>
        </record>
        
        <!-- Kanban View -->
        <record id="umti_course_level_kanban" model="ir.ui.view">
            <field name="name">umti.course.level.kanban</field>
            <field name="model">umti.course.level</field>
            <field name="arch" type="xml">
                <kanban>
                    <templates>
                        <t t-name="card">
                            <main>
                                <field name="name" class="fw-bold fs-5"/>
                                <field name="courses_counts"/>
                            </main>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Search View -->
        <record id="umti_course_level_search" model="ir.ui.view">
            <field name="name">umti.course.level.search</field>
            <field name="model">umti.course.level</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_umti_course_level" model="ir.actions.act_window">
            <field name="name">Course Levels</field>
            <field name="res_model">umti.course.level</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="search_view_id" ref="umti_course_level_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first course level!
                </p>
            </field>
        </record>
        
    </data>
</odoo>