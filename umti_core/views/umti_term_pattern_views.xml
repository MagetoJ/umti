<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="umti_term_pattern_view_list" model="ir.ui.view">
        <field name="name">umti.term.pattern.view.list</field>
        <field name="model">umti.term.pattern</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="kind"/>
                <field name="scope"/>
                <field name="anchor"/>
                <field name="line_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="umti_term_pattern_view_form" model="ir.ui.view">
        <field name="name">umti.term.pattern.view.form</field>
        <field name="model">umti.term.pattern</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Pattern">
                            <field name="name"/>
                            <field name="code"/>
                            <field name="kind"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                        <group string="Calendar">
                            <field name="scope"/>
                            <field name="anchor"/>
                            <field name="line_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Periods" name="periods">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence"/>
                                    <field name="name"/>
                                    <field name="phase"/>
                                    <field name="parent_sequence"/>
                                    <field name="is_subterm" readonly="1"/>
                                    <field name="duration_value"/>
                                    <field name="duration_unit"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="umti_term_pattern_view_search" model="ir.ui.view">
        <field name="name">umti.term.pattern.view.search</field>
        <field name="model">umti.term.pattern</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="filter_active" string="Active"
                        domain="[('active', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_kind" string="Kind"
                            context="{'group_by': 'kind'}"/>
                    <filter name="group_scope" string="Scope"
                            context="{'group_by': 'scope'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_umti_term_pattern" model="ir.actions.act_window">
        <field name="name">Term Patterns</field>
        <field name="res_model">umti.term.pattern</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="umti_term_pattern_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define how courses are divided into terms.
            </p>
        </field>
    </record>
</odoo>
