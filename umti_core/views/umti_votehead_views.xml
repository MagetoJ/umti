<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="umti_votehead_view_list" model="ir.ui.view">
        <field name="name">umti.structure.votehead.list</field>
        <field name="model">umti.structure.votehead</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="paid_once"/>
                <field name="refundable"/>
            </list>
        </field>
    </record>

    <record id="umti_votehead_view_form" model="ir.ui.view">
        <field name="name">umti.structure.votehead.form</field>
        <field name="model">umti.structure.votehead</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Votehead">
                            <field name="sequence"/>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                        <group string="Billing">
                            <field name="paid_once"/>
                            <field name="refundable"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="umti_votehead_view_search" model="ir.ui.view">
        <field name="name">umti.structure.votehead.search</field>
        <field name="model">umti.structure.votehead</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="filter_active" string="Active"
                        domain="[('active', '=', True)]"/>
                <filter name="filter_paid_once" string="Paid Once"
                        domain="[('paid_once', '=', True)]"/>
                <filter name="filter_refundable" string="Refundable"
                        domain="[('refundable', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="action_umti_votehead" model="ir.actions.act_window">
        <field name="name">Voteheads</field>
        <field name="res_model">umti.structure.votehead</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="umti_votehead_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define the voteheads used to build fee structures and invoices.
            </p>
        </field>
    </record>
</odoo>
