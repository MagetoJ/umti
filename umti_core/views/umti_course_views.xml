    <!-- Search View -->
    <record id="umti_course_view_search" model="ir.ui.view">
        <field name="name">umti_course.view.search</field>
        <field name="model">umti.course</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="department_id"/>
                <field name="course_level_id"/>
                <filter name="filter_draft" string="Draft" domain="[('status', '=', 'draft')]"/>
                <filter name="filter_active" string="Active" domain="[('status', '=', 'active')]"/>
                <filter name="filter_discontinued" string="Discontinued" domain="[('status', '=', 'discontinued')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
                    <filter name="group_level" string="Course Level" context="{'group_by': 'course_level_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_umti_course" model="ir.actions.act_window">
        <field name="name">Course</field>
        <field name="res_model">umti.course</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="umti_course_view_search"/>
    </record>

    
</odoo>
