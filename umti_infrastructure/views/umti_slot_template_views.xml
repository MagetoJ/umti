<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="umti_slot_template_view_form" model="ir.ui.view">
        <field name="name">umti.timetable.slot.template.form</field>
        <field name="model">umti.timetable.slot.template</field>
        <field name="arch" type="xml">
            <form string="Slot Template">
                <header>
                    <button name="action_apply" string="Apply / Refresh Slots"
                            type="object" class="btn-primary" icon="fa-refresh"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_slots" type="object"
                                class="oe_stat_button" icon="fa-clock-o">
                            <field name="slot_count" widget="statinfo" string="Slots"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Full-time Day (90 min periods)"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="auto_apply"/>
                            <field name="lock_when_in_use"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Periods" name="periods">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="line_type" widget="badge"
                                           decoration-info="line_type == 'regular'"
                                           decoration-warning="line_type == 'exam'"
                                           decoration-success="line_type == 'both'"
                                           decoration-muted="line_type == 'break'"/>
                                    <field name="start_time" widget="float_time"/>
                                    <field name="end_time" widget="float_time"/>
                                    <field name="day_mon"/>
                                    <field name="day_tue"/>
                                    <field name="day_wed"/>
                                    <field name="day_thu"/>
                                    <field name="day_fri"/>
                                    <field name="day_sat"/>
                                    <field name="day_sun"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="umti_slot_template_view_list" model="ir.ui.view">
        <field name="name">umti.timetable.slot.template.list</field>
        <field name="model">umti.timetable.slot.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="line_count"/>
                <field name="slot_count"/>
                <field name="auto_apply" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="umti_slot_template_view_search" model="ir.ui.view">
        <field name="name">umti.timetable.slot.template.search</field>
        <field name="model">umti.timetable.slot.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_umti_slot_template" model="ir.actions.act_window">
        <field name="name">Slot Templates</field>
        <field name="res_model">umti.timetable.slot.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first slot template</p>
            <p>Define periods, breaks and exam sessions once, then reuse them
               for any course, level, term pattern or semester.</p>
        </field>
    </record>

</odoo>
