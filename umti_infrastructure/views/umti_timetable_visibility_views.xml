<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========== Student form: smart button + Timetable tab ========== -->
    <record id="school_student_view_form_inherit_timetable" model="ir.ui.view">
        <field name="name">school.student.form.inherit.timetable</field>
        <field name="model">school.student</field>
        <field name="inherit_id" ref="umti_trainers.school_student_view_form_inherit_trainers"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_view_enrollments']" position="after">
                <button name="action_view_timetable" type="object"
                        class="oe_stat_button" icon="fa-calendar">
                    <field name="class_schedule_count" string="Timetable"
                           widget="statinfo"/>
                </button>
            </xpath>
            <xpath expr="//page[@name='unit_enrollments']" position="after">
                <page string="Timetable" name="class_timetable">
                    <field name="class_schedule_ids" readonly="1">
                        <list default_order="day_of_week, start_time">
                            <field name="day_of_week"/>
                            <field name="slot_id"/>
                            <field name="unit_id"/>
                            <field name="facility_id"/>
                            <field name="trainer_id"/>
                            <field name="academic_term_id" optional="hide"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ========== Trainers: smart button + Timetable tab ========== -->
    <record id="umti_trainer_allocation_view_form_inherit_timetable" model="ir.ui.view">
        <field name="name">umti.trainer.allocation.form.inherit.timetable</field>
        <field name="model">umti.trainer.allocation</field>
        <field name="inherit_id" ref="umti_trainers.umti_trainer_allocation_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_timetable" type="object"
                            class="oe_stat_button" icon="fa-calendar">
                        <field name="class_schedule_count" string="Timetable"
                               widget="statinfo"/>
                    </button>
                </div>
            </xpath>
            <xpath expr="//sheet/group" position="after">
                <notebook>
                    <page string="Timetable" name="class_timetable">
                        <field name="class_schedule_ids" readonly="1">
                            <list default_order="day_of_week, start_time">
                                <field name="day_of_week"/>
                                <field name="slot_id"/>
                                <field name="course_id"/>
                                <field name="unit_id"/>
                                <field name="facility_id"/>
                                <field name="student_count"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <!-- ========== My Timetable (trainer workspace) ========== -->
    <record id="action_umti_my_timetable" model="ir.actions.act_window">
        <field name="name">My Timetable</field>
        <field name="res_model">umti.class.schedule</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('trainer_id', '=', uid)]</field>
        <field name="context">{'group_by': ['day_of_week'], 'create': False}</field>
        <field name="search_view_id" ref="umti_class_schedule_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No classes assigned to you yet</p>
            <p>Classes appear here once the timetable office schedules them for you.</p>
        </field>
    </record>

    <menuitem id="menu_umti_my_timetable"
              name="My Timetable"
              parent="umti_trainers.menu_umti_trainers_root"
              action="action_umti_my_timetable"
              sequence="12"/>

    <!-- Bulk enrollment from the student list / form -->
    <record id="action_server_enroll_course_units" model="ir.actions.server">
        <field name="name">Enroll Course Units</field>
        <field name="model_id" ref="umti_students.model_school_student"/>
        <field name="binding_model_id" ref="umti_students.model_school_student"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_enroll_course_units()</field>
    </record>

</odoo>
