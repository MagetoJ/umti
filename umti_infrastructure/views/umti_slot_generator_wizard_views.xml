<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="umti_slot_generator_wizard_view_form" model="ir.ui.view">
        <field name="name">umti.slot.generator.wizard.form</field>
        <field name="model">umti.slot.generator.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Time Slots">
                <group>
                    <field name="template_id" options="{'no_create': True}"/>
                </group>
                <p class="text-muted">
                    Times and working days are defined on the template
                    (Configuration &gt; Slot Templates). Existing slots are
                    reused, never duplicated.
                </p>
                <footer>
                    <button name="action_generate_slots" string="Generate Time Slots" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_umti_slot_generator_wizard" model="ir.actions.act_window">
        <field name="name">Generate Time Slots</field>
        <field name="res_model">umti.slot.generator.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
