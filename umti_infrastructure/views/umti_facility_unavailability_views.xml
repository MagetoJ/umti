<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Facility Unavailability List -->
    <record id="umti_facility_unavailability_view_list" model="ir.ui.view">
        <field name="name">umti.facility.unavailability.list</field>
        <field name="model">umti.facility.unavailability</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="facility_id"/>
                <field name="day_of_week"/>
                <field name="slot_id"/>
                <field name="reason"/>
            </list>
        </field>
    </record>

    <!-- Facility Unavailability Action -->
    <record id="action_umti_facility_unavailability" model="ir.actions.act_window">
        <field name="name">Facility Unavailability</field>
        <field name="res_model">umti.facility.unavailability</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No maintenance windows</p>
            <p>Mark specific time slots as unavailable for a facility.</p>
        </field>
    </record>

</odoo>
