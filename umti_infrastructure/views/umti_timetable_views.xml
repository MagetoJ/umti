<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== Time slots ===== -->
    <record id="umti_timetable_slot_view_tree" model="ir.ui.view">
        <field name="name">umti.timetable.slot.list</field>
        <field name="model">umti.timetable.slot</field>
        <field name="arch" type="xml">
            <list>
                <field name="display_name"/>
                <field name="day_of_week"/>
                <field name="start_time" widget="float_time"/>
                <field name="end_time" widget="float_time"/>
                <field name="slot_type"/>
                <field name="template_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="umti_timetable_slot_view_search" model="ir.ui.view">
        <field name="name">umti.timetable.slot.search</field>
        <field name="model">umti.timetable.slot</field>
        <field name="arch" type="xml">
            <search>
                <field name="display_name"/>
                <field name="template_id"/>
                <filter string="Class Slots" name="regular" domain="[('slot_type', 'in', ['regular', 'both'])]"/>
                <filter string="Exam Slots" name="exam" domain="[('slot_type', 'in', ['exam', 'both'])]"/>
                <group expand="0" string="Group By">
                    <filter string="Day" name="group_day" context="{'group_by': 'day_of_week'}"/>
                    <filter string="Template" name="group_template" context="{'group_by': 'template_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_umti_timetable_slot" model="ir.actions.act_window">
        <field name="name">Time Slots</field>
        <field name="res_model">umti.timetable.slot</field>
        <field name="view_mode">list</field>
    </record>

    <!-- ===== Class schedule ===== -->
    <record id="umti_class_schedule_view_tree" model="ir.ui.view">
        <field name="name">umti.class.schedule.list</field>
        <field name="model">umti.class.schedule</field>
        <field name="arch" type="xml">
            <list>
                <field name="academic_term_id"/>
                <field name="course_id"/>
                <field name="unit_id"/>
                <field name="trainer_id"/>
                <field name="facility_id"/>
                <field name="slot_id"/>
                <field name="day_label"/>
                <field name="time_range"/>
            </list>
        </field>
    </record>

    <record id="umti_class_schedule_view_form" model="ir.ui.view">
        <field name="name">umti.class.schedule.form</field>
        <field name="model">umti.class.schedule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="academic_term_id"/>
                            <field name="course_id"/>
                            <field name="level_id"/>
                            <field name="group_id"/>
                            <field name="unit_id"/>
                        </group>
                        <group>
                            <field name="trainer_id"/>
                            <field name="facility_id"/>
                            <field name="slot_id"/>
                            <field name="day_label"/>
                            <field name="time_range"/>
                            <field name="student_count"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="umti_class_schedule_view_search" model="ir.ui.view">
        <field name="name">umti.class.schedule.search</field>
        <field name="model">umti.class.schedule</field>
        <field name="arch" type="xml">
            <search>
                <field name="unit_id"/>
                <field name="course_id"/>
                <field name="trainer_id"/>
                <field name="facility_id"/>
                <group expand="0" string="Group By">
                    <filter string="Semester" name="group_term" context="{'group_by': 'academic_term_id'}"/>
                    <filter string="Trainer" name="group_trainer" context="{'group_by': 'trainer_id'}"/>
                    <filter string="Room" name="group_room" context="{'group_by': 'facility_id'}"/>
                    <filter string="Day" name="group_day" context="{'group_by': 'day_of_week'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_umti_class_schedule" model="ir.actions.act_window">
        <field name="name">Class Timetable</field>
        <field name="res_model">umti.class.schedule</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="umti_class_schedule_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Schedule a class</p>
            <p>Assign units to trainers, rooms and time slots.</p>
        </field>
    </record>

    <!-- ===== Exam schedule ===== -->
    <record id="umti_exam_schedule_view_tree" model="ir.ui.view">
        <field name="name">umti.exam.schedule.list</field>
        <field name="model">umti.exam.schedule</field>
        <field name="arch" type="xml">
            <list>
                <field name="exam_date"/>
                <field name="assessment_id"/>
                <field name="unit_id"/>
                <field name="slot_id"/>
                <field name="facility_id"/>
                <field name="invigilator_id"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="umti_exam_schedule_view_form" model="ir.ui.view">
        <field name="name">umti.exam.schedule.form</field>
        <field name="model">umti.exam.schedule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="assessment_id"/>
                            <field name="academic_term_id"/>
                            <field name="course_id"/>
                            <field name="unit_id"/>
                        </group>
                        <group>
                            <field name="exam_date"/>
                            <field name="slot_id"/>
                            <field name="facility_id"/>
                            <field name="invigilator_id"/>
                            <field name="status"/>
                            <field name="schedule_note"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_umti_exam_schedule" model="ir.actions.act_window">
        <field name="name">Exam Schedule</field>
        <field name="res_model">umti.exam.schedule</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
