<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Campus Infrastructure ladder. Rooms, time slots and the timetable
             are configuration: everyone reads them, the timetable office
             (manager) edits them, only the administrator deletes them. -->
        <record id="group_umti_infrastructure_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_umti_infrastructure"/>
            <field name="implied_ids" eval="[
                (4, ref('base.group_user')),
                (4, ref('umti_core.group_umti_user')),
                (4, ref('umti_core.group_umti_department_user')),
                (4, ref('umti_core.group_umti_academic_year_user'))]"/>
        </record>

        <record id="group_umti_infrastructure_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_umti_infrastructure"/>
            <field name="implied_ids" eval="[(4, ref('group_umti_infrastructure_user'))]"/>
        </record>

        <record id="group_umti_infrastructure_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_umti_infrastructure"/>
            <field name="implied_ids" eval="[(4, ref('group_umti_infrastructure_manager'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

    </data>
</odoo>
