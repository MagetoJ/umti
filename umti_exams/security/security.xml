<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_umti_exams" model="ir.module.category">
        <field name="name">UMTI Exams and Assessment</field>
        <field name="parent_id" ref="umti_core.module_category_umti_core"/>
    </record>

    <record id="group_umti_exams_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_umti_exams"/>
        <field name="implied_ids" eval="[(4, ref('umti_students.group_umti_students_user'))]"/>
    </record>

    <!-- Head of Department: sets the assessment plan for their own department.
         Sits between User and Manager so the groups stay a linear hierarchy. -->
    <record id="group_umti_exams_hod" model="res.groups">
        <field name="name">Head of Department</field>
        <field name="category_id" ref="module_category_umti_exams"/>
        <field name="implied_ids" eval="[(4, ref('group_umti_exams_user'))]"/>
    </record>

    <!-- Manager implies the umti_students Manager group, because publishing a
         unit result writes umti.exam.record. -->
    <record id="group_umti_exams_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_umti_exams"/>
        <field name="implied_ids" eval="[(4, ref('group_umti_exams_hod')), (4, ref('umti_students.group_umti_students_manager'))]"/>
    </record>

    <record id="group_umti_exams_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_umti_exams"/>
        <field name="implied_ids" eval="[(4, ref('group_umti_exams_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
