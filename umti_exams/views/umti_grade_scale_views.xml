<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="umti_grade_scale_view_list" model="ir.ui.view">
        <field name="name">umti.grade.scale.list</field>
        <field name="model">umti.grade.scale</field>
        <field name="arch" type="xml">
            <list string="Grade Scales">
                <field name="name"/>
                <field name="code"/>
                <field name="pass_mark"/>
                <field name="is_default" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="umti_grade_scale_view_form" model="ir.ui.view">
        <field name="name">umti.grade.scale.form</field>
        <field name="model">umti.grade.scale</field>
        <field name="arch" type="xml">
            <form string="Grade Scale">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. TVET CBET Grade Scale"/></h1>
                    </div>

                    <group>
                        <group string="Scale Identification">
                            <field name="code" placeholder="e.g. GS-2026"/>
                            <field name="pass_mark" widget="float" digits="[5,2]"/>
                        </group>
                        <group string="Settings">
                            <field name="is_default" widget="boolean_toggle"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Grade Schedule Breakdown" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="grade" string="Grade / Key"/>
                                    <field name="min_mark" string="Min Score (%)"/>
                                    <field name="max_mark" string="Max Score (%)"/>
                                    <field name="result_status" widget="badge"
                                           decoration-success="result_status == 'pass'"
                                           decoration-danger="result_status == 'fail'"/>
                                    <field name="description" string="Descriptor / Remarks"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_umti_grade_scale" model="ir.actions.act_window">
        <field name="name">Grade Scales</field>
        <field name="res_model">umti.grade.scale</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first Grade Scale</p>
        </field>
    </record>

</odoo>